#/-------------------.env.vault---------------------/
#/         cloud-agnostic vaulting standard         /
#/   [how it works](https://dotenv.org/env-vault)   /
#/--------------------------------------------------/

# production
DOTENV_VAULT_PRODUCTION=""
DOTENV_VAULT_PRODUCTION_VERSION=42

# development
DOTENV_VAULT_DEVELOPMENT=""
DOTENV_VAULT_DEVELOPMENT_VERSION=6

# ci
DOTENV_VAULT_CI=""
DOTENV_VAULT_CI_VERSION=35

# staging
DOTENV_VAULT_STAGING=""
DOTENV_VAULT_STAGING_VERSION=43

#/----------------settings/metadata-----------------/
DOTENV_VAULT="vlt_c3bfd1e9d81092fce3f8ade4965ff9ab340bac3a694908988f165eb297d29a0d"
DOTENV_API_URL="https://vault.dotenv.org"
DOTENV_CLI="npx dotenv-vault@latest"
