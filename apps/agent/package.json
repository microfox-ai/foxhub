{
  "name": "foxhub-agent",
  "version": "1.0.0",
  "description": "Foxhub Agent",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && serverless deploy --stage dev",
    "deploy:staging": "npm run build && serverless deploy --verbose --stage staging",
    "deploy:prod": "npm run build && serverless deploy --verbose --stage prod",
    "remove:staging": "serverless remove --stage staging",
    "remove:prod": "serverless remove --stage prod",
    "lint": "eslint  --ignore-path .gitignore ."
  },
  "dependencies": {
    "@microfox/task-kit": "^1.0.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "serverless": "^3.38.0",
    "serverless-api-gateway-throttling": "^2.0.3",
    "serverless-plugin-typescript": "^2.1.5",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "extends": "@serverless/eslint-config/node",
    "root": true
  }
}
