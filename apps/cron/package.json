{
  "name": "foxhub-cron-service",
  "version": "1.0.0",
  "description": "FoxHub Cron Service - Standalone cron job service with concurrency support",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "node-cron": "^4.1.0",
    "uuid": "^10.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.8.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cron",
    "scheduler",
    "microservice",
    "nodejs",
    "concurrent"
  ]
}
