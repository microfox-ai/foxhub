generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConfigData {
  id         String   @id @default(uuid())
  configId   String   @unique
  configType String   @default("")
  configApp  String?  @default("portal")
  configData Json?
  timestamp  DateTime @updatedAt
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  avatar             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isOnboarded        Boolean             @default(false)
  onboardingData     Json?
  projectPermissions ProjectPermission[]
  isAdmin            Boolean?
  isBetaAccess       Boolean?
  isBillingVerified  Boolean?
}

model FoxTemplate {
  id              String          @id @default(uuid())
  name            String
  foxType         String
  foxDescription  String
  focCapabilities String[]
  messageCount    Int             @default(0)
  tokenCount      Int             @default(0)
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  messages        ChatUIMessage[]
}

model ChatUIMessage {
  id                    String        @id @default(uuid())
  context               String?
  role                  String
  content               String
  parts                 Json[]
  attachments           Json[]
  annotations           Json[]
  minionId              String?
  minionType            String?
  minionFlow            String?
  userId                String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequestId String
  revisionId            String?
  toolInvocations       Json[]
  metadata              Json?
  minion                FoxTemplate?  @relation(fields: [minionId], references: [id])
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model BotProject {
  id               String              @id @default(uuid())
  userId           String
  name             String
  githubRepoName   String              @unique
  githubRepoUrl    String
  githubRepoBranch String?             @default("main")
  prUrl            String?
  prNumber         Int?
  description      String?
  projectDir       String
  templateVersion  String?
  awsRegion        String             @default("us-east-1")
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  archiveStatus    String?
  slug             String?
  imageUrl         String?
  homepageUrl      String?
  clientRequests   ClientRequest[]
  clientSecrets    ClientSecret[]
  permissions      ProjectPermission[]
}

model ProjectPermission {
  id           String              @id @default(uuid())
  botProjectId String
  userId       String
  accessType   PROJECT_ACCESS_TYPE
  role         PROJECTROLE
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  botProject   BotProject          @relation(fields: [botProjectId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

  @@unique([botProjectId, userId])
  @@index([botProjectId])
  @@index([userId])
}

model ClientRequest {
  id                       String             @id @default(uuid())
  botProjectId             String
  userId                   String
  mentionedClientSecretIds String[]
  title                    String             @default("Untitled")
  minionFlow               String?
  description              String?
  repoName                 String?
  prUrl                    String?
  prNumber                 Int?
  prBranch                 String?
  prTargetBranch           String?
  awsRegion                String             @default("us-east-1")
  requestDir               String?
  requestStatus            REQUESTSTATUS      @default(UN_ASSIGNED)
  archiveStatus            String?
  templateVersion          String?
  metadata                 Json?
  lastUpdatedAt            DateTime?          @default(now())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  serviceName              String?
  chatUIMessages           ChatUIMessage[]
  deployedFunctions        ClientDeployment[]
  botProject               BotProject         @relation(fields: [botProjectId], references: [id])
  requestUpdates           RequestUpdate[]
  taskInstanceMeta         TaskInstanceMeta?
}

model TaskInstanceMeta {
  id                    String        @id @default(uuid())
  originClientRequestId String        @unique
  taskInfo              Json?
  initialSummary        String?
  taskIntegrations      Json?
  taskRequiredInfo      Json?
  taskStructure         Json?
  buildingStep          Json?
  deployStep            Json?
  minionType            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model ChatAgenticState {
  id                    String        @id @default(uuid())
  originClientRequestId String        @unique
  state                 Json?
}

model UsageAnalytics {
  id               String  @id @unique @default(uuid())
  matchId          String  @unique
  promptTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  completionTokens Int     @default(0)
  invocations      Int     @default(0)
  model            String?
  hour             String?
  day              String?
  month            String?
  requestId        String?
  projectId        String?
  userId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt        
}

model ClientSecret {
  id                  String             @id @default(uuid())
  botProjectId        String
  clientRequestIds    String[]
  userId              String
  name                String
  type                String
  variables           Json[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  status              CLIENTSECRETSTATUS @default(FILLED)
  botConfig           Json[]             @default([])
  clientDeploymentIds String[]
  packageConstructor  String?
  packageName         String?
  packageType         String?
  isHidden            Boolean?
  templateId          String?
  tokenResponse       Json?
  identityMetadata    Json?
  identityUserId      String?
  identityTeamId     String?
  identityOrgId       String?
  awsRegion           String?
  botProject          BotProject         @relation(fields: [botProjectId], references: [id])
}

model ClientSecretTemplate {
  id                  String             @id @default(uuid())
  templateId          String
  templateType        String?            // free, markup, testing, official
  name                String
  type                String
  imageUrl            String?
  variables           Json[]
  priceMarkupPercent  Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  botConfig           Json[]             @default([])
  packageConstructor  String?
  packageName         String?
  packageType         String?
  metadata            Json?
}

model ClientDeployment {
  id                    String        @id @default(uuid())
  userId                String
  botProjectId          String
  originClientRequestId String
  name                  String        @unique
  sha                   String?
  baseUrl               String
  awsRegion             String        @default("us-east-1")
  stage                 DEPLOY_STAGE
  type                  FUNCTIONTYPE
  status                DEPLOY_STATUS @default(TRIGGERED)
  docs                  String?
  endpoints             Json[]        @default([])
  schedules             Json[]        @default([])
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  clientSecretIds       String[]
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model RequestUpdate {
  id                    String        @id @default(uuid())
  originClientRequestId String
  botProjectId          String
  userId                String
  prUrl                 String
  prNumber              Int
  prBranch              String
  prTargetBranch        String
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model WhatsAppVerification {
  id             String   @id @default(uuid())
  clientSecretId String
  userId         String
  code           String
  slug           String
  phoneNumber    String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  callbackUri    String?

  @@index([clientSecretId, code])
  @@index([userId])
  @@index([clientSecretId])
  @@index([slug])
}

enum CLIENTSECRETSTATUS {
  EMPTY
  FILLED
}

enum DEPLOY_STAGE {
  DEV
  PROD
  STAGING
  PREVIEW
}

enum DEPLOY_STATUS {
  TRIGGERED
  DEPLOYED
  ARCHIVED
}

enum REQUESTSTATUS {
  UN_ASSIGNED
  IN_DEVELOPMENT
  IN_REVIEW
  CLOSED
  COMPLETED
}

enum FUNCTIONTYPE {
  WEBHOOK
  CRON
  MIXED
}

enum PROJECTROLE {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum PROJECT_ACCESS_TYPE {
  READ
  WRITE
}

// ------- StorePresence ---------

model ShardPage {
  id             String   @id @default(uuid())
  taskInstanceMeta Json
  status         SHARD_PAGE_STATUS @default(UNPUBLISHED)
  category       String[]
  clientRequestMeta Json
  repoDir        String
  slug           String   @unique
  title          String?
  miniDescription String?
  description    String?
  video_url      String?
  thumbnail_url  String?
  banner_url     String?
  version        String
  versionNumber  String
  creatorId      String?
  clientRequestId String?
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum SHARD_PAGE_STATUS {
  UNPUBLISHED
  PUBLISHED
}


// ------- Billing ---------

model UsageReport {
  id              String        @id @default(uuid())
  originClientRequestId   String?
  originBotProjectId    String?
  priceUSD        Float
  cycle           String        @default("daily")
  dateKey         String
  description     String?
  computeTime     Float
  metadata        Json?
  usageLogs       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// -------- Process Webhook Events ------

model WebhookEvent {
  id              String        @id @default(uuid())
  status          String?
  originClientRequestId   String?
  originBotProjectId    String?
  provider        String
  event_id        String?
  event_name      String?
  payload         Json?
  triggerRoute    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ------- API Embeddings -------
model api_embeddings {
  id                    String           @id @default(uuid())
  user_id                String?
  bot_project_id          String?
  origin_client_request_id String?
  base_url               String
  schema_path            String?
  endpoint_path          String
  http_method            String
  doc_text               String
  embedding             Unsupported("vector(768)")?
  is_public              Boolean          @default(false)
  stage                 deployment_stage @default(STAGING)
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([bot_project_id])
}

enum deployment_stage {
  DEV
  STAGING
  PREVIEW
  PROD
}

// =================================================================
//  Task Kit Tables
//  This script creates the tables required for the @microfox/task-kit
//  package, based on the Zod schemas.
// =================================================================

// -----------------------------------------------------------------
//  Custom Types (Enums)
//  These types enforce specific values for task properties.
// -----------------------------------------------------------------

enum task_status {
  pending
  scheduled
  progress
  input_await
  completed
  failed
  archived
}

enum task_type {
  default
  watcher
  scheduled
  stale
}

enum task_priority {
  low
  medium
  high
  critical
}

enum event_status {
  unclassified
  classified
  failed
}

// -----------------------------------------------------------------
//  Table: events
//  Logs raw incoming events before they are classified into tasks.
// -----------------------------------------------------------------

model Event {
  id                   String        @id @default(uuid())
  microfoxIds          String[]
  createdAt            DateTime      @default(now())
  providerName         String?
  providerEventId      String?
  eventType            String
  status               event_status  @default(unclassified)
  content              String?
  metadata             Json?
  classificationNotes  String?
  tasks                Task[]

  @@index([providerEventId])
  @@index([status])
  @@index(map: "idx_events_microfox_ids", fields: [microfoxIds])

  @@map("events")
}

// -----------------------------------------------------------------
//  Table: tasks
//  Stores individual tasks to be processed.
// -----------------------------------------------------------------

model Task {
  id                  String          @id @default(uuid())
  microfoxId          String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  scheduledFor        DateTime?
  expiresAt           DateTime?
  name                String?
  taskType            task_type
  status              task_status
  priority            task_priority?
  authorizedUsers     String[]
  input               Json?
  output              Json?
  metadata            Json?
  providerName        String?
  aiDescription       String?
  triggeringEventId   String?
  triggeringEvent     Event?          @relation(fields: [triggeringEventId], references: [id], onDelete: SetNull)
  activities          Activity[]
  eventWatchers       EventWatcher[]

  @@index([microfoxId])
  @@index([status])
  @@index([priority])
  @@index([providerName])
  @@index([scheduledFor])
  @@index([triggeringEventId])
  @@map("tasks")
}

// -----------------------------------------------------------------
//  Table: activities
//  Records a sequence of actions or events within a single task.
// -----------------------------------------------------------------

model Activity {
  id                String    @id @default(uuid())
  taskId            String
  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sequenceNumber    Int
  parentActivityId  String?
  parentActivity    Activity? @relation("ActivityChildren", fields: [parentActivityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childActivities   Activity[] @relation("ActivityChildren")
  prevActivityId    String?
  nextActivityId    String?
  type              String
  timestamp         DateTime  @default(now())
  messageId         String?
  messageContent    String?
  metadata          Json?
  messageMetadata   Json?
  aiGeneratedData   Json?

  @@unique([taskId, sequenceNumber])
  @@index([taskId])
  @@index([type])
  @@index([parentActivityId])
  @@map("activities")
}

// -----------------------------------------------------------------
//  Table: event_watchers
//  Defines rules to match incoming events to tasks.
// -----------------------------------------------------------------

model EventWatcher {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  microfoxId      String
  providerName    String
  eventType       String
  teamId          String?
  organizationId  String?
  matchQuery      Json
  createdAt       DateTime @default(now())

  @@index([taskId])
  @@index(map: "idx_event_watchers_keys", fields: [microfoxId, providerName, eventType])
  @@map("event_watchers")
}

