generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConfigData {
  id         String   @id @default(uuid())
  configId   String   @unique
  configType String   @default("")
  configApp  String?  @default("portal")
  configData Json?
  timestamp  DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoxTemplate {
  id              String          @id @default(uuid())
  name            String
  foxType         String
  foxDescription  String
  focCapabilities String[]
  messageCount    Int             @default(0)
  tokenCount      Int             @default(0)
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  messages        ChatUIMessage[]
}

model ChatUIMessage {
  id                    String        @id @default(uuid())
  context               String?
  role                  String
  content               String
  parts                 Json[]
  attachments           Json[]
  annotations           Json[]
  minionId              String?
  minionType            String?
  userId                String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequestId String
  revisionId           String?
  toolInvocations       Json[]
  minion                FoxTemplate?  @relation(fields: [minionId], references: [id])
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model BotProject {
  id               String          @id @default(uuid())
  userId           String
  name             String
  githubRepoName   String          @unique
  githubRepoUrl    String
  githubRepoBranch String?         @default("main")
  prUrl            String?
  prNumber         Int?
  description      String?
  projectDir       String
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clientRequests   ClientRequest[]
  clientSecrets    ClientSecret[]
}

model ClientRequest {
  id                       String                  @id @default(uuid())
  botProjectId             String
  userId                   String
  mentionedClientSecretIds String[]
  title                    String                  @default("Untitled")
  description              String?
  prUrl                    String?
  prNumber                 Int?
  prBranch                 String?
  prTargetBranch           String?
  requestDir               String?
  requestStatus            REQUESTSTATUS           @default(UN_ASSIGNED)
  metadata                 Json?
  lastUpdatedAt            DateTime?               @default(now())
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  chatUIMessages           ChatUIMessage[]
  botProject               BotProject              @relation(fields: [botProjectId], references: [id])
  deployedFunctions        ClientRequestFunction[]
  requestUpdates           RequestUpdate[]
  taskInstanceMeta         Json?
}

model TaskInstanceMeta {
  id              String @id @default(uuid())
  taskInstance    Json?
  minionType          String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt       
}

model ClientSecret {
  id               String     @id @default(uuid())
  botProjectId     String
  clientRequestIds String[]
  userId           String
  name             String
  type             String
  variables        Json[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  botProject       BotProject @relation(fields: [botProjectId], references: [id])
}

model ClientRequestFunction {
  id                    String        @id @default(uuid())
  userId                String
  botProjectId          String
  originClientRequestId String
  name                  String        @unique
  baseUrl               String
  mode                  SECRETMODE
  type                  FUNCTIONTYPE
  endpoints             Json[]
  schedules             Json[]
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}


model RequestUpdate {
  id                    String        @id @default(uuid())
  originClientRequestId String
  botProjectId          String
  userId                String
  prUrl                 String
  prNumber              Int
  prBranch              String
  prTargetBranch        String
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

enum SECRETMODE {
  DEV
  PROD
  STAGING
  PREVIEW
}

enum REQUESTSTATUS {
  UN_ASSIGNED
  IN_DEVELOPMENT
  IN_REVIEW
  CLOSED
  COMPLETED
}

enum FUNCTIONTYPE {
  WEBHOOK
  API
  SCHEDULED
}