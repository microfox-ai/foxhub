generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConfigData {
  id         String   @id @default(uuid())
  configId   String   @unique
  configType String   @default("")
  configApp  String?  @default("portal")
  configData Json?
  timestamp  DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  onboardingData Json?
  isOnboarded Boolean @default(false)
  projectPermissions ProjectPermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoxTemplate {
  id              String          @id @default(uuid())
  name            String
  foxType         String
  foxDescription  String
  focCapabilities String[]
  messageCount    Int             @default(0)
  tokenCount      Int             @default(0)
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  messages        ChatUIMessage[]
}

model ChatUIMessage {
  id                    String        @id @default(uuid())
  context               String?
  role                  String
  content               String
  parts                 Json[]
  attachments           Json[]
  annotations           Json[]
  minionId              String?
  minionType            String?
  userId                String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequestId String
  revisionId            String?
  toolInvocations       Json[]
  minion                FoxTemplate?  @relation(fields: [minionId], references: [id])
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model BotProject {
  id               String          @id @default(uuid())
  userId           String
  name             String
  imageUrl         String?
  githubRepoName   String          @unique
  githubRepoUrl    String
  githubRepoBranch String?         @default("main")
  prUrl            String?
  prNumber         Int?
  slug             String?         
  description      String?
  projectDir       String
  templateVersion  String?
  permissions      ProjectPermission[]
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clientRequests   ClientRequest[]
  clientSecrets    ClientSecret[]
}

model ProjectPermission {
  id             String               @id @default(uuid())
  botProjectId   String               
  userId         String
  accessType     PROJECT_ACCESS_TYPE 
  role           PROJECTROLE
  botProject     BotProject           @relation(fields: [botProjectId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([botProjectId, userId])
  @@index([botProjectId])
  @@index([userId])
}

model ClientRequest {
  id                       String             @id @default(uuid())
  botProjectId             String
  userId                   String
  mentionedClientSecretIds String[]
  title                    String             @default("Untitled")
  description              String?
  serviceName              String?
  repoName                 String?
  prUrl                    String?
  prNumber                 Int?
  prBranch                 String?
  prTargetBranch           String?
  requestDir               String?
  requestStatus            REQUESTSTATUS      @default(UN_ASSIGNED)
  templateVersion          String?
  metadata                 Json?
  lastUpdatedAt            DateTime?          @default(now())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  chatUIMessages           ChatUIMessage[]
  botProject               BotProject         @relation(fields: [botProjectId], references: [id])
  deployedFunctions        ClientDeployment[]
  requestUpdates           RequestUpdate[]
  taskInstanceMeta         TaskInstanceMeta?
}

model TaskInstanceMeta {
  id                    String        @id @default(uuid())
  originClientRequestId String        @unique
  taskInfo              Json?
  initialSummary        String?
  taskIntegrations      Json?
  taskRequiredInfo      Json?
  taskStructure         Json? // this should be in seperate model in future
  buildingStep          Json?
  deployStep            Json?
  minionType            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model UsageAnalytics {
  id               String  @id @unique @default(uuid())
  matchId          String  @unique // userId+requestId+projectId
  promptTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  completionTokens Int     @default(0)
  model            String?
  hour             String?
  day              String?
  month            String?
}

model ClientSecret {
  id               String     @id @default(uuid())
  botProjectId     String
  clientRequestIds String[]
  clientDeploymentIds String[]
  userId           String
  name             String
  packageName      String?
  packageConstructor String?
  packageType      String? // template / custom / oauth
  type             String // packageName/constructor
  variables        Json[] // this will be in the format of { key: "apiKey", value: "1234567890", isOptional: false}
  status           CLIENTSECRETSTATUS @default(FILLED)
  botConfig        Json[]             @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  botProject       BotProject @relation(fields: [botProjectId], references: [id])
}

model ClientDeployment {
  id                    String        @id @default(uuid())
  userId                String
  botProjectId          String
  originClientRequestId String
  clientSecretIds       String[]
  name                  String        @unique
  baseUrl               String
  stage                 DEPLOY_STAGE
  type                  FUNCTIONTYPE
  docs                  String?
  endpoints             Json[]        @default([])
  schedules             Json[]        @default([])
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model RequestUpdate {
  id                    String        @id @default(uuid())
  originClientRequestId String
  botProjectId          String
  userId                String
  prUrl                 String
  prNumber              Int
  prBranch              String
  prTargetBranch        String
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  originClientRequest   ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model WhatsAppVerification {
  id        String   @id @default(uuid())
  clientSecretId  String   // clientSecretId of the whatsapp bot
  userId    String // userId of the user who is connecting the whatsapp bot (provided by the client)
  code      String // verification code for the whatsapp bot
  slug      String    // slug provided by the client (provider)
  phoneNumber String? 
  isVerified Boolean @default(false)
  callbackUri String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientSecretId, code])
  @@index([userId])
  @@index([clientSecretId])
  @@index([slug])
}

enum CLIENTSECRETSTATUS {
  EMPTY
  FILLED
}

enum DEPLOY_STAGE {
  DEV
  PROD
  STAGING
  PREVIEW
}

enum REQUESTSTATUS {
  UN_ASSIGNED
  IN_DEVELOPMENT
  IN_REVIEW
  CLOSED
  COMPLETED
}

enum FUNCTIONTYPE {
  WEBHOOK
  CRON
  MIXED
}

enum PROJECTROLE {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum PROJECT_ACCESS_TYPE {
  READ
  WRITE
}

