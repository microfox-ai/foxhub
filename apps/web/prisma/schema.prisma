// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConfigData {
  id         String   @id @default(uuid())
  configId   String   @unique
  configType String   @default("")
  configApp  String?  @default("portal")
  configData Json?
  timestamp  DateTime @updatedAt
}

// -------------------------------------Custom Bots-------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoxTemplate {
  id        String   @id @default(uuid())
  name      String
  foxType   String // 'hello' | 'convert' | 'build' | 'package'
  foxDescription  String
  focCapabilities String[]
  messageCount  Int @default(0)
  tokenCount    Int @default(0)
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  messages   ChatUIMessage[]
}

model ChatUIMessage {
  id        String   @id @default(uuid())
  context   String // 'chat' | 'server'
  role      String   // 'user' | 'assistant' | 'system'
  content   String
  parts       Json[]  // 'text' | 'toolCall' | 'source' 
  attachments Json[]
  annotations Json[]
  metadata              Json?
  minionId     String? 
  minionType   String? // 'hello' | 'convert' | 'build' | 'package'
  userId       String 
  systemType   String? //  'git' | 'server'


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originClientRequestId String   
  originClientRequest ClientRequest @relation(fields: [originClientRequestId], references: [id])

  minion       FoxTemplate?  @relation(fields: [minionId], references: [id])
}

model BotProject {
  id               String          @id @default(uuid())
  userId         String
  name             String
  githubRepoName   String
  githubRepoUrl    String
  githubRepoBranch String?         @default("main")
  prUrl            String?
  prNumber         Int?
  description      String?
  projectDir       String
  clientSecrets       ClientSecret[]
  clientRequests   ClientRequest[]
  previewConfigs   Json?
  prodConfigs      Json?
  stagingConfigs   Json?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ClientSecretTemplate {
  id           String  @id @default(uuid())
  userId     String? // Nullable: Only set if it's a custom template
  name         String // Template name
  type         String // Bot types supported by this template
  requiredKeys Json[] // Keys required for this bot template (mode: SECRETMODE[], isOptional: Boolean, key: String, placeholder: String?)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientSecret {
  id               String   @id @default(uuid())
  botProjectId     String   
  clientRequestIds String[] 
  userId         String
  name             String
  type             String // Bot types supported by this template, e.g. "X", "SLACK", "WHATSAPP", "TELEGRAM", "DISCORD", "GITHUB", "EMAIL", "INSTAGRAM", "YOUTUBE", "WEB_APP"
  variables        Json[] // Stores environment variables required for the bot (mode: SECRETMODE[], isOptional: Boolean, key: String, value?: String)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  botProject BotProject @relation(fields: [botProjectId], references: [id])
}

model ClientRequestFunction {
  id                    String       @id @default(uuid())
  userId              String
  botProjectId          String       
  originClientRequestId String       
  name                  String       @unique // Function name (e.g., "Create Post", "Read Posts")
  baseUrl               String // Base URL for the deployed function
  mode                  SECRETMODE // Mode of the function (e.g., "PROD", "STAGING")
  type                  FUNCTIONTYPE // Function type (e.g., "webhook", "api", "scheduled")
  endpoints             Json[] // Multiple endpoints mapped to this function (will have method, headers, bodySchema, responseSchema)
  schedules             Json[] // Schedule for the function
  metadata              Json? // Metadata about the function

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originClientRequest ClientRequest @relation(fields: [originClientRequestId], references: [id])
}

model ClientRequest {
  id                    String                  @id @default(uuid())
  botProjectId          String                  
  userId              String
  mentionedClientSecretIds String[]
  title                 String
  description           String
  prUrl                 String
  prNumber              Int
  prBranch              String
  prTargetBranch        String
  requestDir            String
  requestStatus         REQUESTSTATUS           @default(UN_ASSIGNED)
  requestUpdates        RequestUpdate[]
  chatUIMessages       ChatUIMessage[]
  deployedFunctions     ClientRequestFunction[]
  metadata              Json?
  lastUpdatedAt         DateTime?               @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  botProject BotProject @relation(fields: [botProjectId], references: [id])
}

enum SECRETMODE {
  DEV
  PROD
  STAGING
  PREVIEW
}

enum REQUESTSTATUS {
  UN_ASSIGNED
  IN_DEVELOPMENT
  IN_REVIEW
  CLOSED
  COMPLETED
}

enum FUNCTIONTYPE {
  WEBHOOK
  API
  SCHEDULED
}

model RequestUpdate {
  id                    String   @id @default(uuid())
  originClientRequestId String   
  botProjectId          String   
  userId              String // Identifier for who created this bot
  prUrl                 String
  prNumber              Int
  prBranch              String
  prTargetBranch        String
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  originClientRequest ClientRequest @relation(fields: [originClientRequestId], references: [id])
}
