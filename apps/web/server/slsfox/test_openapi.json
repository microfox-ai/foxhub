{
  "openapi": "3.0.1",
  "info": {
    "title": "ragreddit API",
    "version": "1.0.0",
    "description": "API for the ragreddit agent.",
    "contact": {
      "name": "API Support",
      "email": "support@microfox.app"
    }
  },
  "servers": [
    {
      "url": "https://api.microfox.com/agents/ragreddit",
      "description": "Production server"
    }
  ],
  "paths": {
    "/subreddit/index": {
      "post": {
        "summary": "Trigger subreddit indexing",
        "description": "Triggers the indexing of a specific subreddit by sending a message to the SQS queue.",
        "tags": ["Subreddit"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subreddit": {
                    "type": "string",
                    "description": "The name of the subreddit to index."
                  }
                },
                "required": ["subreddit"]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: The indexing request has been successfully queued."
          },
          "400": {
            "description": "Bad Request: Missing or invalid request body."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/userSearch": {
      "post": {
        "summary": "Trigger a user search",
        "description": "Triggers a search for keywords within specified subreddits. This is an asynchronous operation that queues a search task.",
        "tags": ["User Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The query to search for."
                  },
                  "subreddits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A list of subreddits to search in."
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A list of keywords to search for."
                  }
                },
                "required": ["subreddits", "keywords"]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: The user search has been successfully queued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "searchId": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: Missing or invalid request body."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/userSearch/{searchId}": {
      "get": {
        "summary": "Get user search results",
        "description": "Retrieves the results of a user search by its ID.",
        "tags": ["User Search"],
        "pathParameters": {
          "type": "object",
          "properties": {
            "searchId": {
              "type": "string",
              "description": "The ID of the search to retrieve.",
              "required": true
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK: The search results were retrieved successfully."
          },
          "400": {
            "description": "Bad Request: Missing searchId in path."
          },
          "404": {
            "description": "Not Found: The search ID does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "summary": "Update a user search",
        "description": "Updates an existing user search with new keywords or subreddits. This can trigger re-evaluation and re-indexing of subreddits.",
        "tags": ["User Search"],
        "pathParameters": {
          "type": "object",
          "properties": {
            "userSearchId": {
              "type": "string",
              "description": "The ID of the user search to update.",
              "required": true
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "A new query to find more subreddits. This will re-evaluate subreddits based on keywords from the query."
                  },
                  "subreddits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A list of subreddit names to add to the search with high priority."
                  },
                  "title": {
                    "type": "string",
                    "description": "A new title for the user search."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK: The user search was updated successfully."
          },
          "400": {
            "description": "Bad Request: Missing userSearchId in path or missing request body."
          },
          "404": {
            "description": "Not Found: The user search with the given ID was not found."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/userSearchReport/{userSearchId}": {
      "get": {
        "summary": "Get user search report",
        "description": "Retrieves a user search report by its ID.",
        "tags": ["User Search Report"],
        "pathParameters": {
          "type": "object",
          "properties": {
            "userSearchId": {
              "type": "string",
              "description": "The ID of the report to retrieve.",
              "required": true
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK: The report was retrieved successfully."
          },
          "400": {
            "description": "Bad Request: Missing userSearchId in path."
          },
          "404": {
            "description": "Not Found: The userSearchId report does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "x-auth-packages": [
      {
        "packageName": "@microfox/reddit"
      },
      {
        "packageName": "@microfox/ai-provider-anthropic"
      }
    ]
  }
}
