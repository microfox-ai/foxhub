{
  "name": "foxhub",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "build:ci": "dotenv -- turbo run build --filter=./apps/web",
    "build:ci:gitbot": "dotenv -- turbo run build --filter=./apps/gitbot",
    "start:ci": "node -r dotenv/config apps/web/server.js",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:generate": "prisma generate --schema=./apps/web/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./apps/web/prisma/schema.prisma",
    "prisma:migrate-dev-reset": "prisma migrate reset --schema=./apps/web/prisma/schema.prisma",
    "prisma:migrate-dev": "prisma migrate dev --schema=./apps/web/prisma/schema.prisma",
    "prisma:migrate-deploy": "dotenv -- prisma migrate deploy --schema=./apps/web/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/aws-lambda": "^8.10.142",
    "@types/body-parser": "^1.19.5",
    "@types/caseless": "^0.12.3",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minimatch": "^5.1.2",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.13.9",
    "@types/qs": "^6.9.15",
    "@types/range-parser": "^1.2.7",
    "@types/react": "19.0.10",
    "@types/send": "^0.17.4",
    "@types/serve-static": "^1.15.7",
    "@types/through": "^0.0.32",
    "@types/tough-cookie": "^4.0.5",
    "@types/webidl-conversions": "^7.0.3",
    "@types/yargs-parser": "^21.0.3",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.800.0",
    "@types/json-schema": "^7.0.15",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0"
  }
}
